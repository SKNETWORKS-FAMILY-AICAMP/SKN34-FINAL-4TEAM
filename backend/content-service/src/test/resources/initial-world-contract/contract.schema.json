{
  "$defs": {
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Key",
          "type": "string"
        },
        "expectedDraftRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expecteddraftrevision",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "expectedDraftRevision"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "AnalysisResponse": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "format": "uuid",
          "title": "Analysisid",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "executionStatus": {
          "enum": [
            "running",
            "completed",
            "failed",
            "unknown"
          ],
          "title": "Executionstatus",
          "type": "string"
        },
        "freshness": {
          "enum": [
            "current",
            "stale"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/Output"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateIds": {
          "patternProperties": {
            "^[A-Za-z0-9:_-]+$": {
              "format": "uuid",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Candidateids",
          "type": "object"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionRecord"
          },
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "analysisId",
        "basis",
        "executionStatus",
        "freshness",
        "output",
        "candidateIds",
        "decisions"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "ApplicationRequest": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Key",
          "type": "string"
        },
        "expectedDraftRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expecteddraftrevision",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Selection"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "key",
        "expectedDraftRevision",
        "candidates"
      ],
      "title": "ApplicationRequest",
      "type": "object"
    },
    "ApplicationResponse": {
      "additionalProperties": false,
      "properties": {
        "applicationId": {
          "format": "uuid",
          "title": "Applicationid",
          "type": "string"
        },
        "status": {
          "enum": [
            "applying",
            "applied",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "baseDraftRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Basedraftrevision",
          "type": "integer"
        },
        "resultDraftRevision": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resultdraftrevision"
        },
        "createdCardIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Createdcardids",
          "type": "array"
        },
        "createdRelationshipIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Createdrelationshipids",
          "type": "array"
        }
      },
      "required": [
        "applicationId",
        "status",
        "baseDraftRevision",
        "resultDraftRevision",
        "createdCardIds",
        "createdRelationshipIds"
      ],
      "title": "ApplicationResponse",
      "type": "object"
    },
    "Basis": {
      "additionalProperties": false,
      "properties": {
        "draftRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Draftrevision",
          "type": "integer"
        },
        "relationshipVersion": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Relationshipversion",
          "type": "integer"
        },
        "currentRevisionId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentrevisionid"
        },
        "inputHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inputhash",
          "type": "string"
        }
      },
      "required": [
        "draftRevision",
        "relationshipVersion",
        "currentRevisionId",
        "inputHash"
      ],
      "title": "Basis",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "localRef": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Localref",
          "type": "string"
        },
        "type": {
          "enum": [
            "fact",
            "relation",
            "rule",
            "event",
            "conjecture",
            "goal",
            "plan"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "subjectId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subjectid"
        },
        "relatedEntityIds": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Relatedentityids",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "ai_extraction",
            "author_revision",
            "author_addition"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Relation"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "maxLength": 3000,
          "title": "Condition",
          "type": "string"
        },
        "timeText": {
          "maxLength": 3000,
          "title": "Timetext",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "asserted",
            "denied"
          ],
          "title": "Polarity",
          "type": "string"
        }
      },
      "required": [
        "localRef",
        "type",
        "title",
        "text",
        "subjectId",
        "relatedEntityIds",
        "provenance",
        "evidence",
        "relation",
        "condition",
        "timeText",
        "polarity"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "format": "uuid",
          "title": "Candidateid",
          "type": "string"
        },
        "candidateRef": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Candidateref",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "held",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Candidate"
        }
      },
      "required": [
        "candidateId",
        "candidateRef",
        "sequence",
        "state",
        "content"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "DecisionRequest": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Key",
          "type": "string"
        },
        "expectedDecisionSequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expecteddecisionsequence",
          "type": "integer"
        },
        "action": {
          "enum": [
            "approve",
            "edit",
            "hold",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "editedCandidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment": {
          "maxLength": 3000,
          "title": "Comment",
          "type": "string"
        }
      },
      "required": [
        "key",
        "expectedDecisionSequence",
        "action",
        "editedCandidate",
        "comment"
      ],
      "title": "DecisionRequest",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "format": "uuid",
          "title": "Cardid",
          "type": "string"
        },
        "entityType": {
          "enum": [
            "character",
            "location",
            "organization",
            "ability",
            "object"
          ],
          "title": "Entitytype",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "cardId",
        "entityType",
        "name",
        "aliases"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quoteHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quotehash",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "start",
        "end",
        "quote",
        "quoteHash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "initial-world.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "analysisId": {
          "format": "uuid",
          "title": "Analysisid",
          "type": "string"
        },
        "worldId": {
          "format": "uuid",
          "title": "Worldid",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "analysisId",
        "worldId",
        "basis",
        "sources",
        "entities"
      ],
      "title": "Input",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "initial-world.v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "maxLength": 3000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "candidates",
        "diagnostics"
      ],
      "title": "Output",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "sourceCardId": {
          "format": "uuid",
          "title": "Sourcecardid",
          "type": "string"
        },
        "targetCardId": {
          "format": "uuid",
          "title": "Targetcardid",
          "type": "string"
        },
        "category": {
          "enum": [
            "structural",
            "emotional"
          ],
          "title": "Category",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "direction": {
          "enum": [
            "directed",
            "symmetric"
          ],
          "title": "Direction",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "asserted",
            "denied"
          ],
          "title": "Polarity",
          "type": "string"
        }
      },
      "required": [
        "sourceCardId",
        "targetCardId",
        "category",
        "label",
        "direction",
        "polarity"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "format": "uuid",
          "title": "Candidateid",
          "type": "string"
        },
        "decisionSequence": {
          "minimum": 1,
          "title": "Decisionsequence",
          "type": "integer"
        }
      },
      "required": [
        "candidateId",
        "decisionSequence"
      ],
      "title": "Selection",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Sourceid",
          "type": "string"
        },
        "ownerId": {
          "format": "uuid",
          "title": "Ownerid",
          "type": "string"
        },
        "field": {
          "enum": [
            "description",
            "title",
            "body"
          ],
          "title": "Field",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "title": "Text",
          "type": "string"
        },
        "textHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Texthash",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "ownerId",
        "field",
        "text",
        "textHash"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "API별 $defs와 한 반영 시도를 묶는 테스트 전용 봉투. HTTP DTO가 아니다.",
  "properties": {
    "input": {
      "$ref": "#/$defs/Input"
    },
    "output": {
      "$ref": "#/$defs/Output"
    },
    "analysisRequest": {
      "$ref": "#/$defs/AnalysisRequest"
    },
    "analysisResponse": {
      "$ref": "#/$defs/AnalysisResponse"
    },
    "decisionRequest": {
      "$ref": "#/$defs/DecisionRequest"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      },
      "title": "Decisions",
      "type": "array"
    },
    "applicationRequest": {
      "$ref": "#/$defs/ApplicationRequest"
    },
    "applicationResponse": {
      "$ref": "#/$defs/ApplicationResponse"
    },
    "currentDraftRevision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Currentdraftrevision",
      "type": "integer"
    },
    "currentRelationshipVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Currentrelationshipversion",
      "type": "integer"
    },
    "appliedCandidateIds": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Appliedcandidateids",
      "type": "array"
    }
  },
  "required": [
    "input",
    "output",
    "analysisRequest",
    "analysisResponse",
    "decisionRequest",
    "decisions",
    "applicationRequest",
    "applicationResponse",
    "currentDraftRevision",
    "currentRelationshipVersion",
    "appliedCandidateIds"
  ],
  "title": "Contract",
  "type": "object"
}
