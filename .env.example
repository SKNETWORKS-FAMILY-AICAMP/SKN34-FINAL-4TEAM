# Root local-development settings for bare docker compose and native launchers.
# cp -n .env.example .env (never overwrite an existing file); prepare your own required secrets.
# compose.yaml auto-loads this root .env; it source-builds runtime images, not HMR.
# Health-only foundation boots with an empty key; no model client is constructed.
# Generation constructs the client only after explicit user consent.
OPENAI_API_KEY=
# Set a model explicitly for generation; no team model has been selected.
OPENAI_MODEL=
AI_SERVICE_CONNECT_TIMEOUT=1s
AI_SERVICE_READ_TIMEOUT=12s
AI_GENERATION_READ_TIMEOUT=75s

# Loopback host ports. Internal service DNS/ports remain fixed.
WEB_PORT=5173
CORE_API_PORT=8080
CONTENT_SERVICE_PORT=8081
# Blank derives http://127.0.0.1:<WEB_PORT> in local Compose.
APP_CORS_ALLOWED_ORIGIN=

# Demo-only account signup: set your own local database credentials in .env.
# Shared PostgreSQL for Core, Content and Operations (one DB, separate Flyway history tables).
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/storyfork
DATABASE_PORT=5432
CORE_SMTP_HOST=127.0.0.1
CORE_SMTP_PORT=1025
CORE_MAILPIT_SMTP_PORT=1025
CORE_MAILPIT_WEB_PORT=8025
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_MAIL_FROM=storyfork@example.invalid
# Generate a unique base64-encoded random key of at least 32 bytes; never commit it.
AUTH_JWT_SECRET=
# false is only for local HTTP; use true with HTTPS in production.
AUTH_COOKIE_SECURE=false

# 알림 사건 소비(RabbitMQ). 기본은 꺼짐. 켜려면 true로 바꾸고 브로커 계정을 직접 정한다(커밋 금지).
# Compose에서는 `--profile events`로 prod 검증 스택에 rabbitmq를 함께 띄운다. 관리 UI 포트는 열지 않는다.
CORE_NOTIFICATION_EVENTS_ENABLED=false
CORE_RABBITMQ_HOST=127.0.0.1
CORE_RABBITMQ_PORT=5672
CORE_RABBITMQ_USER=
CORE_RABBITMQ_PASSWORD=

# Native settings. Compose keeps its internal DNS/proxy overrides.
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
VITE_CORE_API_BASE_URL=http://localhost:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_CONTENT_DEV_PROXY_TARGET=http://localhost:8081
VITE_OPERATIONS_DEV_PROXY_TARGET=http://localhost:8082
VITE_DEV_SERVER_HOST=localhost
# Never put secrets in VITE_* or build arguments.

# Content module: explicit opt-in; PostgreSQL and verified Principal required.
CONTENT_ENABLED=false
# WorldStudio is opt-in after approved SQL migration. Never auto-convert existing relation data.
APP_WORLDSTUDIO_ENABLED=false
# Source-built validation (compose.prod): --profile worldstudio uses internal neo4j DNS. Native Content: set bolt://127.0.0.1:7687 explicitly.
# Image-only develop CD (compose.dev): provision an approved private graph target and override NEO4J_URI; no automatic deployment.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
# Set a private password (at least 8 characters); never put it in VITE_* or a build argument.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7687
# Service credential, separate from user Bearer and JWT signing key. Core + Content only.
# Generate at least 32 random characters locally; no line breaks. Required when content is enabled.
CONTENT_CORE_AUTH_TOKEN=
CORE_AUTH_BASE_URL=http://127.0.0.1:8080
CORE_AUTH_CONNECT_TIMEOUT=1s
CORE_AUTH_READ_TIMEOUT=3s

# Operations API (reports·members·admins): browser reaches only /api/v1/operations/{reports,members,admins}
# through nginx/Vite with the member Bearer. Compose runs it on the container network only (no host port);
# native runs bind 127.0.0.1:8082.
# Service credential for Operations → Core/Content internal calls (X-Operations-Service-Token).
# Generate at least 32 random characters; never share with browsers or VITE_*. Compose injects it into
# Operations, Core and Content. Missing/blank rejects all operations calls (fails closed).
OPERATIONS_SERVICE_TOKEN=
# Native defaults; Compose overrides with internal core-api/content-service DNS.
OPERATIONS_CORE_BASE_URL=http://127.0.0.1:8080
OPERATIONS_CONTENT_BASE_URL=http://127.0.0.1:8081
# Shared only by Content and AI generation. Generate a random value locally.
INTERNAL_TOKEN=

# Private setting attachments (requires CONTENT_ENABLED=true and an existing private bucket).
SETTING_ATTACHMENTS_ENABLED=true
ATTACHMENT_S3_BUCKET=storyfork-setting-attachments
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ENDPOINT=http://127.0.0.1:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Publicly documented LOCAL-ONLY example credentials: replace in your private root .env.
AWS_ACCESS_KEY_ID=storyfork-local
AWS_SECRET_ACCESS_KEY=local-development-only-change-me
# AWS S3 alternatives: blank endpoint and REMOVE local credentials; use the SDK default role/profile chain.
# ATTACHMENT_S3_ENDPOINT=
# ATTACHMENT_S3_REGION=ap-northeast-2
# ATTACHMENT_S3_BUCKET=your-private-s3-bucket
# AWS_PROFILE=your-profile

# Servers use the SAME variable names in their own .env (never copy local values):
# - develop: base + infrastructure/docker-compose.dev.yaml (GHCR :develop). CD_DIRECTORY/CD_WEB_PORT come from the CD workflow;
#   DB/SMTP are internal postgres/mailpit DNS. Approval flags live in GitHub repository settings.
# - production: base + infrastructure/docker-compose.prod.yaml (GHCR :main, not yet published). Also set WEB_PORT,
#   external DATABASE_URL/CORE_SMTP_*, an HTTPS AUTH_PUBLIC_ORIGIN and optional CORE_SMTP_USERNAME/PASSWORD/AUTH.
#   Blank required values fail config; cookies are always Secure.
# Use unique DATABASE_*, AUTH_JWT_SECRET, CONTENT_CORE_AUTH_TOKEN, INTERNAL_TOKEN and OPERATIONS_SERVICE_TOKEN per server.
