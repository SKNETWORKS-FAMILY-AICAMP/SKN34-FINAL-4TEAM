# Root local-development settings for bare docker compose and native launchers.
# cp -n .env.example .env (never overwrite an existing file); prepare your own required secrets.
# compose.yaml auto-loads this root .env; it source-builds runtime images, not HMR.
# Health-only foundation boots with an empty key; no model client is constructed.
# Generation constructs the client only after explicit user consent.
OPENAI_API_KEY=
# Set a model explicitly for generation; no team model has been selected.
OPENAI_MODEL=
# EVALUATION_JUDGE_MODEL=gpt-6.2-sol  # judge model of the ops regression evaluation (Ragas, GEval and the simulation rubric); blank = OPENAI_MODEL. Runs scored by different judges are not comparable: the first comparison after changing it mixes judges
# LLMOPS_MODELS=gpt-6-luna,gpt-6.1-terra,gpt-6-sol,gpt-6.1-sol,gpt-6-astra  # models an ops prompt version may choose (#806); OpenAI models only, the AI service calls nothing else
# EVAL_TOLERANCE=0.1  # a version passes when every metric is at least (baseline mean - this); blank = 0.1. All scores are 0-1 (the simulation rubric's 1-5 scores are recorded as (score-1)/4)
# PROMPT_OPTIMIZER_BASE_URL=http://host.docker.internal:10100/v1  # prompt auto-improvement (GEPA, #823): the reflection model is called only through the local OpenCodex gateway; blank = OpenAI. Generation and scoring keep using OPENAI_API_KEY
# PROMPT_OPTIMIZER_API_KEY=  # key for that gateway; blank = OPENAI_API_KEY (the gateway accepts any string)
# PROMPT_OPTIMIZER_MODEL=gpt-6-sol  # reflection model; blank = gpt-6-sol
AI_SERVICE_CONNECT_TIMEOUT=1s
AI_SERVICE_READ_TIMEOUT=12s
AI_GENERATION_READ_TIMEOUT=75s
# SIMULATION_REASONING_EFFORT=      # blank = low (simulation v2 default); none|minimal|low|medium|high is sent as reasoning.effort on every character-simulation model call (#642)
# SIMULATION_SKIP_FORCED_DIRECTOR=  # 1 = skip the director call for a rule-forced turn that is not a speech (#642)
# SIMULATION_WORLD_CACHE=           # 1 = reuse the world read in-process while world_studio_list draftRevision is unchanged (#642)
# SIMULATION_SKIP_NARRATION_CHECK=  # 1 = skip the check model for omniscient narration; server rules and other turns are still checked (#642)
# SIMULATION_ACT_BASE_URL=          # OpenAI-compatible provider (e.g. https://hemmingway.io/v1): only the character-turn (act) call goes there, as Chat Completions with reasoning_effort; blank = OpenAI
# SIMULATION_ACT_API_KEY=           # that provider's key; required when the base URL is set (OPENAI_API_KEY is never sent to it) and unused without one
# SIMULATION_ACT_MODEL=             # model for the act call; blank = gpt-6.1-terra (service default, user decision 2026-11-23; gpt-6-luna goes back to the old model) or OPENAI_MODEL when the base URL is set
# SIMULATION_ACT_THINKING=          # off = turn the act provider's thinking off (enable_thinking=false; only with the base URL); blank = provider default
# AI 자율 연재(Content, #659): 크레딧 예약 상한. 시뮬레이션 의견은 제출자, 회차 실행은 작품 소유자가 부담하고 AI가 확정한 실제 사용량만큼만 정산한다.
# AI 자율 연재(Content, #659): 크레딧 예약 상한. 시뮬레이션 제안 글은 작성자, 선택지 생성과 회차 실행은 작품 소유자가 부담하고 AI가 확정한 실제 사용량만큼만 정산한다.
# AI 자율 연재(Content, #659): 크레딧 예약 상한. 시뮬레이션 제안 글은 작성자, 선택지 생성·회차 요약·회차 실행은 작품 소유자가 부담하고 AI가 확정한 실제 사용량만큼만 정산한다(회차 본문 하나의 요약이 약 3크레딧).
# 회차 실행(SERIAL_EPISODE_CREDIT_LIMIT)은 인물 시뮬레이션 장면까지 같은 예약으로 세는 추정 상한이라 크고, 소유자의 사용 가능 잔액이 이 값 이상이어야 실행된다.
SERIAL_SIMULATION_CREDIT_LIMIT=5
SERIAL_CHOICE_CREDIT_LIMIT=5
SERIAL_SUMMARY_CREDIT_LIMIT=5
SERIAL_EPISODE_CREDIT_LIMIT=1000
# Writing AI conversation/HITL checkpoints (LangGraph AsyncPostgresSaver). Blank returns 503 for conversation requests.
# Use a dedicated database, never the Core/Content `storyfork` DB (#337). AI creates it on startup when the account may CREATE DATABASE;
# otherwise create it first (e.g. external production PostgreSQL).
# Local Compose example: postgresql://<DATABASE_USER>:<DATABASE_PASSWORD>@postgres:5432/storyfork_ai
AI_CHECKPOINT_DATABASE_URL=
# Langfuse (LLMOps, DEC-55): AI traces every request with these project keys (question, manuscript excerpts and answer text included) and Operations reads the same project with them.
# Blank keys disable tracing. The self-hosted Langfuse (infrastructure/docker-compose.langfuse.yaml) creates the project with the same keys on first start. Keys: pk-lf-<random> / sk-lf-<random>.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Native ai-service only (http://localhost:3000); Compose always uses http://langfuse-web:3000.
LANGFUSE_BASE_URL=
# Self-hosted Langfuse server only (never sent to app services). Generate each with: openssl rand -hex 32
# Langfuse reuses the app postgres (database "langfuse", DATABASE_USER/PASSWORD) and minio (attachment bucket, prefix langfuse/). No web UI port, no login user.
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# Production only (external PostgreSQL/S3): postgresql://<user>:<password>@<host>:5432/langfuse and the S3 endpoint URL.
LANGFUSE_DATABASE_URL=
LANGFUSE_S3_ENDPOINT=

# 원고 기반 최초 세계관 구축 시작 허용(content-service 코드 기본 false, base compose 기본 true)
APP_MANUSCRIPTBUILD_ENABLED=true
# Manuscript index (Elasticsearch): always on since 2026-11-22, there is no on/off flag. Content builds the v1 index at startup and needs Elasticsearch at this URL.
# Local/dev Compose start Elasticsearch themselves and set the URL (http://elasticsearch:9200), so this URL is for native Content only (infrastructure/docker-compose.elasticsearch.yaml).
# Use a dedicated v1 Elasticsearch index for each Content DB.
MANUSCRIPT_INDEX_URL=http://127.0.0.1:9200
MANUSCRIPT_INDEX_NAME=storyfork-manuscript-v1
MANUSCRIPT_INDEX_INTERVAL_MS=60000
MANUSCRIPT_EMBEDDING_MODEL_DIR=

# Optional search index for works, worlds and setting cards (#505). false keeps the DB search; true asks the same Elasticsearch for candidates (search answers 503 if it fails).
SEARCH_INDEX_ENABLED=false
SEARCH_INDEX_URL=http://127.0.0.1:9200
SEARCH_INDEX_INTERVAL_MS=60000

# Loopback host ports. Internal service DNS/ports remain fixed.
WEB_PORT=5173
CORE_API_PORT=8080
CONTENT_SERVICE_PORT=8081
OPERATIONS_SERVICE_PORT=8082
# Blank derives http://127.0.0.1:<WEB_PORT> in local Compose.
APP_CORS_ALLOWED_ORIGIN=

# Demo-only account signup: set your own local database credentials in .env.
# Shared PostgreSQL for Core, Content and Operations (one DB, separate Flyway history tables).
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/storyfork
DATABASE_PORT=5432
CORE_SMTP_HOST=127.0.0.1
CORE_SMTP_PORT=1025
CORE_MAILPIT_SMTP_PORT=1025
CORE_MAILPIT_WEB_PORT=8025
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_MAIL_FROM=storyfork@example.invalid
# Generate a unique base64-encoded random key of at least 32 bytes; never commit it.
AUTH_JWT_SECRET=
# false is only for local HTTP; use true with HTTPS in production.
AUTH_COOKIE_SECURE=false
# 가입 체험 크레딧 지급량(Core). 팀 결정 전이라 0(지급하지 않음)이다. 양수로 바꾸면 가입한 회원에게 한 번 지급하고 30일 뒤 소멸한다.
CREDIT_SIGNUP_TRIAL_AMOUNT=0

# 알림 사건 브로커(RabbitMQ)와 WorldStudio 관계 정본(Neo4j)은 local·개발 배포에서 항상 함께 뜬다.
# 접속 주소는 compose 내부 이름(rabbitmq, neo4j)으로 고정이다. 비밀번호만 정한다(커밋 금지, 8자 이상).
# RabbitMQ 자격(CORE_RABBITMQ_*)은 Core(알림 사건 소비)와 Content(관심 작품 새 회차 사건 발행)가 함께 쓴다.
CORE_RABBITMQ_USER=storyfork
CORE_RABBITMQ_PASSWORD=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7687
# Service credential, separate from user Bearer and JWT signing key. Core + Content only.
# Generate at least 32 random characters locally; no line breaks.
CONTENT_CORE_AUTH_TOKEN=
CORE_AUTH_BASE_URL=http://127.0.0.1:8080
CORE_AUTH_CONNECT_TIMEOUT=1s
CORE_AUTH_READ_TIMEOUT=3s

# Operations API (reports·members·admins·support·notice/event admin): browser reaches only
# /api/v1/operations/{reports,members,admins,support,works,admin/notices,admin/events,admin/activities} (member Bearer) and the anonymous
# GET-only /api/v1/operations/public/{notices,events} through nginx/Vite; the service-token
# /api/v1/operations/{notices,events,inquiries} stay closed. Compose runs it on the container network only
# (no host port); native runs bind 127.0.0.1:8082.
# Service credential for Operations → Core/Content internal calls (X-Operations-Service-Token).
# Generate at least 32 random characters; never share with browsers or VITE_*. Compose injects it into
# Operations, Core and Content. Missing/blank rejects all operations calls (fails closed).
OPERATIONS_SERVICE_TOKEN=
# Native defaults; Compose overrides with internal core-api/content-service DNS.
OPERATIONS_CORE_BASE_URL=http://127.0.0.1:8080
OPERATIONS_CONTENT_BASE_URL=http://127.0.0.1:8081
# Operations, native only (Compose uses internal addresses and copies CORE_RABBITMQ_*): Langfuse Public API (http://127.0.0.1:3000), AI internal API (http://127.0.0.1:8000, uses INTERNAL_TOKEN) and the same RabbitMQ as Core.
OPERATIONS_LANGFUSE_BASE_URL=
OPERATIONS_AI_BASE_URL=
OPERATIONS_RABBITMQ_HOST=
OPERATIONS_RABBITMQ_PORT=
OPERATIONS_RABBITMQ_USERNAME=
OPERATIONS_RABBITMQ_PASSWORD=
# Native ai-service -> Content internal retrieval (Retrieval tool) and Content MCP `/mcp` (approved draft writes).
CONTENT_SERVICE_BASE_URL=http://127.0.0.1:8081
# Shared by Content, Operations and AI (both directions). Use 32+ random characters; Content rejects shorter AI tokens.
INTERNAL_TOKEN=
# 회차 원고 전처리 Celery 브로커(AI), 네이티브 전용이다(Compose는 CORE_RABBITMQ_*로 만들고 RabbitMQ 포트는 열지 않는다). 예: amqp://storyfork:<password>@127.0.0.1:5672// (비밀번호는 영문·숫자만 쓰거나 퍼센트 인코딩)
AI_CELERY_BROKER_URL=
# 원고 전처리 워커(ai-worker)의 동시 작업 수. Compose 기본은 3이며 작업당 회차 추출은 최대 4개가 겹쳐 동시 모델 호출은 최대 이 값×4(기본 12)다.
# 모델 호출은 재시도하지 않아(max_retries=0) OpenAI 사용량 등급이 낮으면 429가 MODEL_UNAVAILABLE이 되어 그 회차가 실패한다. 명시적 실패이며 '같은 작업 재개'로 이어 간다.
AI_PREPROCESSING_CONCURRENCY=3
# AI 작업 워커(ai-jobs-worker: 회귀 평가·운영 정기 작업)의 동시 실행 수. Compose 기본은 4다. 평가는 모델을 많이 불러 값만큼 OpenAI 요청이 동시에 늘어난다.
AI_JOBS_CONCURRENCY=4

# 첨부 파일 저장소. local·개발 배포는 compose의 minio 컨테이너(http://minio:9000)를 항상 쓰고, 버킷은 Content가 시작할 때 만든다.
ATTACHMENT_S3_BUCKET=storyfork-setting-attachments
ATTACHMENT_S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Publicly documented LOCAL-ONLY example credentials: replace in your private root .env.
AWS_ACCESS_KEY_ID=storyfork-local
AWS_SECRET_ACCESS_KEY=local-development-only-change-me

# Servers use the SAME variable names in their own .env (never copy local values):
# - develop: base + infrastructure/docker-compose.dev.yaml (GHCR :develop). CD_DIRECTORY/CD_WEB_PORT come from the CD workflow;
#   DB/SMTP are internal postgres/mailpit DNS. Approval flags live in GitHub repository settings.
# - production: base + infrastructure/docker-compose.prod.yaml (GHCR :main, not yet published). Also set WEB_PORT,
#   external DATABASE_URL/CORE_SMTP_*, an HTTPS AUTH_PUBLIC_ORIGIN and optional CORE_SMTP_USERNAME/PASSWORD/AUTH.
#   Blank required values fail config; cookies are always Secure.
# - develop and production also run Langfuse (DEC-55): set the LANGFUSE_* secrets, project keys and INIT user above; blank required values fail config.
# Use unique DATABASE_*, AUTH_JWT_SECRET, CONTENT_CORE_AUTH_TOKEN, INTERNAL_TOKEN and OPERATIONS_SERVICE_TOKEN per server.

# 이미지 생성 worker (#332): 모델 gpt-image-2.6-flare, quality high는 접수 계약으로 고정.
