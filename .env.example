# Shared project settings for Compose and native launchers.
# Optional: cp -n .env.example .env (never overwrite an existing file).
# Health-only foundation boots with an empty key; no model client is constructed.
# Reserved for future AI-only runtime use, not generation support today.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_SERVICE_CONNECT_TIMEOUT=1s
AI_SERVICE_READ_TIMEOUT=12s

# Loopback host ports. Internal service DNS/ports remain fixed.
DEV_WEB_PORT=5173
CORE_API_PORT=8080
WEB_PORT=8088
# Blank derives http://127.0.0.1:<web port> from the selected Compose file.
APP_CORS_ALLOWED_ORIGIN=

# Native settings. Compose keeps its internal DNS/proxy overrides.
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
VITE_CORE_API_BASE_URL=http://localhost:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Never put secrets in VITE_* or build arguments.
